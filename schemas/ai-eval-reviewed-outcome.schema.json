{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qinglang.local/schemas/ai-eval-reviewed-outcome.schema.json",
  "title": "Git-external human-reviewed real-provider AI evaluation outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "subjectCode",
    "questionType",
    "passed",
    "fabricatedCitation",
    "evaluationRunId",
    "releaseCandidate",
    "caseSha256",
    "responseSha256",
    "sourceKind",
    "sourceReferenceHash",
    "promptVersion",
    "modelProvider",
    "modelName",
    "providerReportedModel",
    "modelConfigSha256",
    "modelRunId",
    "generatedAt",
    "reviewerReference",
    "reviewedAt",
    "attestation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,119}$" },
    "subjectCode": {
      "enum": ["CHINESE", "MATH", "ENGLISH", "MORALITY", "HISTORY", "PHYSICS", "CHEMISTRY"]
    },
    "questionType": {
      "enum": [
        "SINGLE_CHOICE",
        "MULTIPLE_CHOICE",
        "TRUE_FALSE",
        "FILL_BLANK",
        "SHORT_ANSWER",
        "CALCULATION",
        "EXPERIMENT_DESIGN",
        "ERROR_DIAGNOSIS",
        "GRAPHING"
      ]
    },
    "passed": { "type": "boolean" },
    "fabricatedCitation": { "type": "boolean" },
    "evaluationRunId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,119}$" },
    "releaseCandidate": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "caseSha256": { "$ref": "#/$defs/sha256" },
    "responseSha256": { "$ref": "#/$defs/sha256" },
    "sourceKind": {
      "enum": ["AUTHORIZED_PRIVATE", "PUBLIC_DOMAIN", "OPEN_LICENSE", "ORIGINAL_HUMAN"]
    },
    "sourceReferenceHash": { "$ref": "#/$defs/sha256" },
    "promptVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,119}$" },
    "modelProvider": { "const": "openai-compatible" },
    "modelName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "providerReportedModel": { "type": "string", "minLength": 1, "maxLength": 120 },
    "modelConfigSha256": { "$ref": "#/$defs/sha256" },
    "modelRunId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "generatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "reviewerReference": { "type": "string", "minLength": 3, "maxLength": 120 },
    "reviewedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "attestation": { "const": "HUMAN_REVIEWED_REAL_PROVIDER_OUTPUT" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
