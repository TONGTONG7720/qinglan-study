COMPOSE_PROJECT_NAME=qinglang
IMAGE_TAG=replace-with-git-sha
INFRA_IMAGE_TAG=replace-with-reviewed-infrastructure-git-sha
DEPLOY_OWNER_USER=qinglang-deploy
DEPLOY_OWNER_GROUP=qinglang-deploy

API_IMAGE_REPOSITORY=ghcr.io/tongtong7720/qinglan-study-api
MIGRATE_IMAGE_REPOSITORY=ghcr.io/tongtong7720/qinglan-study-migrate
GATEWAY_IMAGE_REPOSITORY=ghcr.io/tongtong7720/qinglan-study-gateway
POSTGRES_IMAGE_REPOSITORY=ghcr.io/tongtong7720/qinglan-study-postgres
BACKUP_IMAGE_REPOSITORY=ghcr.io/tongtong7720/qinglan-study-backup

SITE_ADDRESS=study.example.com
ACME_EMAIL=ops@example.com
ALLOWED_ORIGINS=https://study.example.com
PUBLIC_BIND_IP=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

POSTGRES_DB=qinglang
POSTGRES_ADMIN_USER=qinglang_admin
POSTGRES_MIGRATOR_USER=qinglang_migrator
POSTGRES_APP_USER=qinglang_app
POSTGRES_BACKUP_USER=qinglang_backup

SESSION_COOKIE_NAME=__Host-qinglang_session
EXPECTED_MIGRATION_NAME=20260827032650_question_bank_foundation
MODEL_PROVIDER=disabled
MODEL_BASE_URL=
MODEL_NAME=
MODEL_REASONING_EFFORT=medium
MODEL_TIMEOUT_MS=60000
MODEL_COST_FEN_PER_CALL=10
PRODUCTION_SMOKE_TEST=false

BACKUP_DIR=/var/lib/qinglang/backups
BACKUP_SHARED_GID=2000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_SECONDS=93600
MONITOR_INTERVAL_SECONDS=30
MONITOR_FAILURE_THRESHOLD=3
DEPLOY_STATE_DIR=/var/lib/qinglang/deploy

POSTGRES_ADMIN_PASSWORD_FILE=/etc/qinglang/secrets/postgres_admin_password
POSTGRES_MIGRATOR_PASSWORD_FILE=/etc/qinglang/secrets/postgres_migrator_password
POSTGRES_APP_PASSWORD_FILE=/etc/qinglang/secrets/postgres_app_password
POSTGRES_BACKUP_PASSWORD_FILE=/etc/qinglang/secrets/postgres_backup_password
DATABASE_URL_FILE=/etc/qinglang/secrets/database_url
MIGRATION_DATABASE_URL_FILE=/etc/qinglang/secrets/migration_database_url
BACKUP_DATABASE_URL_FILE=/etc/qinglang/secrets/backup_database_url
REAUTH_PROOF_SECRET_FILE=/etc/qinglang/secrets/reauth_proof_secret
INVITATION_TOKEN_SECRET_FILE=/etc/qinglang/secrets/invitation_token_secret
MODEL_API_KEY_FILE=/etc/qinglang/secrets/model_api_key
ALERT_WEBHOOK_URL_FILE=/etc/qinglang/secrets/alert_webhook_url
