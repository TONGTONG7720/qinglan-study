{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::qinglang-private-production"
    },
    {
      "Sid": "PrivateObjectLifecycleOnly",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::qinglang-private-production/incoming/*",
        "arn:aws:s3:::qinglang-private-production/private/*"
      ]
    }
  ]
}
