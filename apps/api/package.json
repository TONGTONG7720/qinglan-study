{
  "name": "@study/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "scripts/production-monitor.mjs"
  ],
  "scripts": {
    "build": "prisma generate && nest build",
    "curriculum:catalog": "node scripts/build-chaozhou-smartedu-catalog.mjs",
    "curriculum:refresh-catalog-cache": "node scripts/refresh-smartedu-textbook-cache.mjs",
    "curriculum:check-official-releases": "node scripts/check-smartedu-pending-releases.mjs",
    "curriculum:build-morality": "pnpm --filter @study/contracts build && node scripts/build-unified-morality-drafts.mjs",
    "curriculum:build-chinese": "pnpm --filter @study/contracts build && node scripts/build-unified-chinese-drafts.mjs",
    "curriculum:build-history": "pnpm --filter @study/contracts build && node scripts/build-unified-history-drafts.mjs",
    "curriculum:build-math": "pnpm --filter @study/contracts build && node scripts/build-pep-math-drafts.mjs",
    "curriculum:build-english": "pnpm --filter @study/contracts build && node scripts/build-pep-english-drafts.mjs",
    "curriculum:build-physics-chemistry": "pnpm --filter @study/contracts build && node scripts/build-physics-chemistry-drafts.mjs",
    "curriculum:build-legacy-grade9": "pnpm --filter @study/contracts build && node scripts/build-legacy-grade9-current-use-drafts.mjs",
    "curriculum:complete-physics8-upper": "pnpm --filter @study/contracts build && node scripts/complete-physics8-upper-metadata.mjs",
    "curriculum:import": "pnpm --filter @study/contracts build && node scripts/import-curriculum-drafts.mjs",
    "curriculum:sync-knowledge": "pnpm --filter @study/contracts build && node scripts/sync-curriculum-knowledge-metadata.mjs",
    "curriculum:validate": "pnpm --filter @study/contracts build && node scripts/validate-curriculum-drafts.mjs",
    "curriculum:verify-import": "node scripts/verify-curriculum-draft-import.mjs",
    "curriculum:verify-manifest": "pnpm --filter @study/contracts build && node scripts/verify-curriculum-manifest-imports.mjs",
    "curriculum:verify-progress": "node scripts/verify-chaozhou-curriculum-progress.mjs",
    "curriculum:export-physical-review": "node scripts/export-curriculum-physical-review-pack.mjs",
    "curriculum:validate-physical-reviews": "pnpm --filter @study/contracts build && node scripts/validate-curriculum-physical-reviews.mjs",
    "curriculum:prepare-physical-evidence": "node scripts/prepare-curriculum-physical-review-evidence.mjs",
    "curriculum:confirm-all-online": "pnpm --filter @study/contracts build && node scripts/confirm-all-curriculum-online-sources.mjs",
    "curriculum:align-local-preview-student": "pnpm --filter @study/contracts build && node scripts/align-local-preview-student-curriculum.mjs",
    "question-bank:validate-pilot": "pnpm --filter @study/contracts build && node scripts/validate-question-bank-pilot.mjs",
    "question-bank:import-pilot": "pnpm --filter @study/contracts build && node scripts/import-question-bank-pilot.mjs",
    "question-bank:verify-pilot": "pnpm --filter @study/contracts build && node scripts/verify-question-bank-pilot.mjs",
    "question-bank:verify-foundation": "node scripts/verify-question-bank-foundation.mjs",
    "question-bank:export-review-pack": "node scripts/export-question-bank-review-pack.mjs",
    "question-bank:validate-blind-results": "pnpm --filter @study/contracts build && node scripts/validate-question-bank-blind-results.mjs",
    "question-bank:compare-blind-results": "pnpm --filter @study/contracts build && node scripts/compare-question-bank-blind-results.mjs",
    "dev": "pnpm --filter @study/contracts build && prisma generate && nest start --watch",
    "lint": "pnpm --filter @study/contracts build && prisma generate && eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "seed:local-preview": "node scripts/seed-local-preview.mjs",
    "family:onboard-real": "pnpm --filter @study/contracts build && node scripts/onboard-real-family.mjs",
    "start": "node dist/main.js",
    "test": "prisma generate && vitest run --config vitest.config.ts --passWithNoTests",
    "test:e2e": "pnpm --filter @study/contracts build && prisma generate && vitest run --config vitest.e2e.config.ts",
    "typecheck": "pnpm --filter @study/contracts build && prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@study/contracts": "workspace:*",
    "argon2": "0.45.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "prisma": "7.9.1",
    "vitest": "4.1.10"
  }
}
